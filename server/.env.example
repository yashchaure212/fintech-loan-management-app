NODE_ENV=development
PORT=5000

# Neon / PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset email (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# demo = self-reported EMI payments (portfolio only)
# live = Razorpay order + signature verification
PAYMENTS_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional seed overrides
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
