generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  email    String @unique
  phone    String @unique
  password String

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  deletedAt DateTime?

  refreshTokens RefreshToken[]

  passwordResetTokens PasswordResetToken[]

  customerProfile CustomerProfile?

  addresses Address[]

  employment EmploymentDetails?

  kycDocuments KycDocument[]

  loanApplications LoanApplication[]

  // Status history entries created by this user
  statusChanges LoanApplicationStatusHistory[] @relation("StatusChangedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Gender {
  MALE

  FEMALE

  OTHER
}

enum AddressType {
  PERMANENT

  CURRENT

  OFFICE
}

enum EmploymentType {
  SALARIED

  SELF_EMPLOYED

  BUSINESS
}

enum DocumentType {
  PAN_CARD

  AADHAAR_CARD

  SALARY_SLIP

  BANK_STATEMENT

  PHOTO
}

enum DocumentStatus {
  PENDING

  VERIFIED

  REJECTED
}

model CustomerProfile {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String

  lastName String?

  dateOfBirth DateTime?

  gender Gender?

  panNumber String? @unique

  aadhaarNumber String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model Address {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type AddressType

  line1 String

  line2 String?

  city String

  state String

  pincode String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model EmploymentDetails {
  id String @id @default(uuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  employmentType EmploymentType

  companyName String?

  designation String?

  monthlyIncome Decimal @db.Decimal(12, 2)

  experienceYears Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("employment_details")
}

model KycDocument {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType DocumentType

  documentUrl String

  publicId String?

  status DocumentStatus @default(PENDING)

  rejectionReason String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("kyc_documents")
}

enum LoanCategory {
  SECURED
  UNSECURED
}

model LoanType {
  id String @id @default(uuid())

  name String
  code String @unique

  description String?

  category LoanCategory

  icon String?

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interestConfigurations LoanInterestConfiguration[]
  eligibilityRules       LoanEligibility[]
  requiredDocuments      LoanRequiredDocument[]
  loanApplications       LoanApplication[]

  @@index([code])
  @@index([isActive])
  @@index([displayOrder])
  @@map("loan_types")
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

model LoanApplication {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  loanTypeId String
  loanType   LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)

  applicationNumber String @unique

  loanAmount Decimal @db.Decimal(15, 2)

  tenureMonths Int

  interestRate Decimal @db.Decimal(5, 2)

  processingFee Decimal @db.Decimal(10, 2)

  emi Decimal @db.Decimal(12, 2)

  totalInterest Decimal @db.Decimal(15, 2)

  totalAmount Decimal @db.Decimal(15, 2)

  configurationSnapshot Json

  status LoanApplicationStatus @default(SUBMITTED)

  submittedAt DateTime @default(now())

  approvedAt DateTime?

  rejectedAt DateTime?

  disbursedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  statusHistory LoanApplicationStatusHistory[]

  @@index([userId])
  @@index([loanTypeId])
  @@index([status])
  @@map("loan_applications")
}

enum ProcessingFeeType {
  FIXED
  PERCENTAGE
}

model LoanInterestConfiguration {
  id String @id @default(uuid())

  loanTypeId String

  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)

  minAmount Decimal @db.Decimal(15, 2)
  maxAmount Decimal @db.Decimal(15, 2)

  minTenure Int
  maxTenure Int

  interestRate Decimal @db.Decimal(5, 2)

  processingFee Decimal @db.Decimal(10, 2)
  processingFeeType ProcessingFeeType

  gstPercentage Decimal @db.Decimal(5, 2)

  latePenalty Decimal? @db.Decimal(10, 2)
  foreclosureCharge Decimal? @db.Decimal(10, 2)

  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?

  isActive Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_interest_configurations")
}

model LoanEligibility {
  id String @id @default(uuid())

  loanTypeId String

  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)

  minimumAge Int

  maximumAge Int

  minimumIncome Decimal @db.Decimal(12, 2)

  minimumExperience Int?

  minimumCreditScore Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_eligibilities")
}

model LoanRequiredDocument {
  id String @id @default(uuid())

  loanTypeId String

  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)

  documentType DocumentType

  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([loanTypeId])
  @@map("loan_required_documents")
}

model LoanApplicationStatusHistory {
  id String @id @default(uuid())

  loanApplicationId String

  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  status LoanApplicationStatus

  remarks String?

  changedById String

  changedBy User     @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([loanApplicationId])
  @@index([changedById])
  @@map("loan_application_status_history")
}
