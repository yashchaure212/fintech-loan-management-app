generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  email    String @unique
  phone    String @unique
  password String

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  deletedAt DateTime?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customerProfile CustomerProfile?
  addresses Address[]
  loanApplications LoanApplication[]

  // Status history entries created by this user
  statusChanges LoanApplicationStatusHistory[] @relation("StatusChangedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  FARMER
  CONTRACT
  RETIRED
  OTHER
}

enum DocumentOwnerType {
  APPLICANT
  STUDENT
  FATHER
  MOTHER
  CO_APPLICANT
}

enum DocumentType {
  AADHAAR_CARD
  PAN_CARD
  PHOTO
  BANK_STATEMENT
  SALARY_SLIP
  ADMISSION_LETTER
  FEE_STRUCTURE
  BUSINESS_PROOF
  BUSINESS_REGISTRATION
  GST_CERTIFICATE
  LAND_RECORD
  INCOME_PROOF
  CONTRACT_LETTER
  TENTH_MARKSHEET
  TWELFTH_MARKSHEET
  ENTRANCE_SCORECARD
  COLLEGE_ID_CARD
  PREVIOUS_DEGREE_CERTIFICATE
  PASSPORT
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model LoanDocument {
  id String @id @default(uuid())

  loanApplicationId String
  loanApplication LoanApplication @relation (fields: [loanApplicationId], references: [id], onDelete: Cascade)
  ownerType DocumentOwnerType
  documentType DocumentType
  documentUrl String
  publicId String?
  status DocumentStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanApplicationId])
  @@index([documentType])
  @@index([status])

  // Enforced in DB via partial unique index: one non-rejected document per slot.
  @@map("loan_documents")
}

model CustomerProfile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName String?
  dateOfBirth DateTime?
  gender Gender?
  panNumber String? @unique
  aadhaarNumber String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

enum AddressType {
  PERMANENT
  CURRENT
  OFFICE
}

model Address {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type AddressType
  line1 String
  line2 String?
  city String
  state String
  pincode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

enum LoanCategory {
  SECURED
  UNSECURED
}

model LoanType {
  id String @id @default(uuid())

  name String
  code String @unique
  description String?
  category LoanCategory
  icon String?
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interestConfigurations LoanInterestConfiguration[]
  eligibilityRules       LoanEligibility[]
  requiredDocuments      LoanRequiredDocument[]
  loanApplications       LoanApplication[]

  @@index([code])
  @@index([isActive])
  @@index([displayOrder])
  @@map("loan_types")
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

model LoanApplication {
  id String @id @default(uuid())

  userId String
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  loanTypeId String
  loanType   LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  applicationNumber String @unique
  loanAmount Decimal? @db.Decimal(15, 2)
  tenureMonths Int?
  interestRate Decimal? @db.Decimal(5, 2)
  processingFee Decimal? @db.Decimal(10, 2)
  emi Decimal? @db.Decimal(12, 2)
  totalInterest Decimal? @db.Decimal(15, 2)
  totalAmount Decimal? @db.Decimal(15, 2)
  configurationSnapshot Json?
  status LoanApplicationStatus @default(DRAFT)
  currentStep Int @default(1)
  submittedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?
  disbursedAt DateTime?
  statusHistory LoanApplicationStatusHistory[]
  emiSchedules EmiSchedule[]
  documents LoanDocument[]
  educationLoan EducationLoanApplication?
  personalLoan PersonalLoanApplication?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([loanTypeId])
  @@index([status])

  @@map("loan_applications")
}

enum AdmissionStatus {
  APPLIED
  CONFIRMED
}

model EducationLoanApplication {
  id String @id @default(uuid())

  loanApplicationId String @unique
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  studentName String
  dateOfBirth DateTime
  gender Gender
  mobile String
  email String
  aadhaarNumber String?
  panNumber String?
  courseName String
  collegeName String
  universityName String
  studyCountry String
  courseDurationMonths Int
  admissionStatus AdmissionStatus
  estimatedCourseFee Decimal @db.Decimal(15, 2)
  parents ParentDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("education_loan_applications")
}

enum ParentRelation {
  FATHER
  MOTHER
}

model ParentDetails {
  id String @id @default(uuid())

  educationLoanApplicationId String
  educationLoanApplication EducationLoanApplication @relation(fields: [educationLoanApplicationId], references: [id], onDelete: Cascade)

  relation ParentRelation
  fullName String
  mobile String
  aadhaarNumber String?
  panNumber String?
  isCoApplicant Boolean @default(false)

  // Bank Details
  bankAccountNumber String?
  ifscCode String?

  employment ParentEmployment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([educationLoanApplicationId, relation])
  @@index([educationLoanApplicationId])

  @@map("parent_details")
}
model ParentEmployment {
  id String @id @default(uuid())

  parentId String @unique
  parent ParentDetails @relation(fields: [parentId], references: [id], onDelete: Cascade )
  employmentType EmploymentType

  // Salaried
  companyName String?
  designation String?
  monthlyIncome Decimal? @db.Decimal(12, 2)
  experienceYears Int?

  // Business
  businessName String?
  businessType String?
  annualTurnover Decimal? @db.Decimal(15, 2)
  annualIncome Decimal? @db.Decimal(12, 2)

  // Farmer
  landHoldingAcres Decimal? @db.Decimal(10, 2)
  cropType String?
  agriculturalIncome Decimal? @db.Decimal(12, 2)

  // Contract
  employerName String?
  contractDurationMonths Int?

  // Other
  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent_employment")
}

enum PersonalLoanPurpose {
  MEDICAL
  MARRIAGE
  TRAVEL
  HOME_RENOVATION
  BUSINESS
  EDUCATION
  DEBT_CONSOLIDATION
  OTHER
}

model PersonalLoanApplication {
  id String @id @default(uuid())

  loanApplicationId String @unique
  loanApplication LoanApplication @relation (fields: [loanApplicationId], references: [id],onDelete: Cascade)
  purpose PersonalLoanPurpose
  purposeDescription String?
  employment ApplicantEmployment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_loan_applications")
}

model ApplicantEmployment {
  id String @id @default(uuid())

  personalLoanApplicationId String @unique
  personalLoanApplication PersonalLoanApplication @relation( fields: [personalLoanApplicationId],references: [id],onDelete: Cascade)
  employmentType EmploymentType

  // Salaried
  companyName String?
  designation String?
  monthlyIncome Decimal? @db.Decimal(12, 2)
  experienceYears Int?

  // Self-employed
  profession String?

  // Business
  businessName String?
  businessType String?
  annualTurnover Decimal? @db.Decimal(15, 2)
  annualIncome Decimal? @db.Decimal(12, 2)

  // Contract
  employerName String?
  contractDurationMonths Int?

  // Other
  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applicant_employment")
}

enum ProcessingFeeType {
  FIXED
  PERCENTAGE
}

enum EMIStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

model LoanInterestConfiguration {
  id String @id @default(uuid())

  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)
  minAmount Decimal @db.Decimal(15, 2)
  maxAmount Decimal @db.Decimal(15, 2)
  minTenure Int
  maxTenure Int
  interestRate Decimal @db.Decimal(5, 2)
  processingFee Decimal @db.Decimal(10, 2)
  processingFeeType ProcessingFeeType
  gstPercentage Decimal @db.Decimal(5, 2)
  latePenalty Decimal? @db.Decimal(10, 2)
  foreclosureCharge Decimal? @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_interest_configurations")
}

model LoanEligibility {
  id String @id @default(uuid())
  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)
  minimumAge Int
  maximumAge Int
  minimumIncome Decimal @db.Decimal(12, 2)
  minimumExperience Int?
  minimumCreditScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_eligibilities")
}

model LoanRequiredDocument {
  id String @id @default(uuid())

  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade )

  documentType DocumentType
  ownerType DocumentOwnerType
  employmentType EmploymentType?
  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([loanTypeId])
  @@index([documentType])

  @@map("loan_required_documents")
}
model LoanApplicationStatusHistory {
  id String @id @default(uuid())
  loanApplicationId String
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  status LoanApplicationStatus
  remarks String?
  changedById String
  changedBy User     @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([loanApplicationId])
  @@index([changedById])
  @@map("loan_application_status_history")
}

model EmiSchedule {
  id String @id @default(uuid())
  loanApplicationId String
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate DateTime
  openingPrincipal Decimal @db.Decimal(15, 2)
  principalAmount Decimal @db.Decimal(15, 2)
  interestAmount Decimal @db.Decimal(15, 2)
  emiAmount Decimal @db.Decimal(15, 2)
  closingPrincipal Decimal @db.Decimal(15, 2)
  paidAmount Decimal @default(0) @db.Decimal(15, 2)
  paymentDate DateTime?
  latePenalty Decimal? @db.Decimal(10, 2)
  status EMIStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments EmiPayment[]

  @@index([loanApplicationId])
  @@index([status])
  @@index([dueDate])

  @@map("emi_schedules")
}

model EmiPayment {
  id String @id @default(uuid())
  emiScheduleId String
  emiSchedule EmiSchedule @relation(fields: [emiScheduleId], references: [id], onDelete: Cascade)
  paymentReference String @unique
  amount Decimal @db.Decimal(15, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus
  transactionId String?
  remarks String?
  paidAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([emiScheduleId])
  @@index([paymentStatus])

  @@map("emi_payments")
}