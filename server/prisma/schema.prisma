generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id String @id @default(uuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  email    String @unique
  phone    String @unique
  password String

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  deletedAt DateTime?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customerProfile CustomerProfile?
  addresses Address[]
  loanApplications LoanApplication[]

  // Status history entries created by this user
  statusChanges LoanApplicationStatusHistory[] @relation("StatusChangedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  FARMER
  CONTRACT
  RETIRED
  OTHER
}

enum DocumentOwnerType {
  APPLICANT
  STUDENT
  FATHER
  MOTHER
  CO_APPLICANT
  GUARDIAN
}

enum DocumentType {
  AADHAAR_CARD
  PAN_CARD
  PHOTO
  BANK_STATEMENT
  SALARY_SLIP
  ADMISSION_LETTER
  FEE_STRUCTURE
  BUSINESS_PROOF
  BUSINESS_REGISTRATION
  GST_CERTIFICATE
  LAND_RECORD
  INCOME_PROOF
  CONTRACT_LETTER
  TENTH_MARKSHEET
  TWELFTH_MARKSHEET
  ENTRANCE_SCORECARD
  COLLEGE_ID_CARD
  PREVIOUS_DEGREE_CERTIFICATE
  PASSPORT
  OTHER
  BIRTH_CERTIFICATE
  ADDRESS_PROOF
  SCHOOL_ADMISSION_PROOF
  PREVIOUS_CLASS_RESULT
  UDYAM_CERTIFICATE
  LAND_LEASE_PROOF
  EXISTING_LOAN_STATEMENT
  FINANCIAL_STATEMENT
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model LoanDocument {
  id String @id @default(uuid())

  loanApplicationId String
  loanApplication LoanApplication @relation (fields: [loanApplicationId], references: [id], onDelete: Cascade)
  ownerType DocumentOwnerType
  documentType DocumentType
  documentUrl String
  publicId String?
  resourceType String @default("image")
  status DocumentStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanApplicationId])
  @@index([documentType])
  @@index([status])

  // Enforced in DB via partial unique index: one non-rejected document per slot.
  @@map("loan_documents")
}

model CustomerProfile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName String?
  dateOfBirth DateTime?
  gender Gender?
  panNumber String? @unique
  aadhaarNumber String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

enum AddressType {
  PERMANENT
  CURRENT
  OFFICE
}

model Address {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type AddressType
  line1 String
  line2 String?
  city String
  taluka String?
  district String?
  state String
  pincode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCurrentAddressFor   ParentDetails[]    @relation("ParentCurrentAddress")
  parentPermanentAddressFor ParentDetails[]    @relation("ParentPermanentAddress")
  employerAddressFor        ParentEmployment[] @relation("EmployerAddress")
  businessAddressFor        ParentEmployment[] @relation("BusinessAddress")
  landAddressFor            ParentEmployment[] @relation("LandAddress")

  @@index([userId])
  @@map("addresses")
}

enum LoanCategory {
  SECURED
  UNSECURED
}

model LoanType {
  id String @id @default(uuid())

  name String
  code String @unique
  description String?
  category LoanCategory
  icon String?
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interestConfigurations LoanInterestConfiguration[]
  eligibilityRules       LoanEligibility[]
  requiredDocuments      LoanRequiredDocument[]
  loanApplications       LoanApplication[]

  @@index([code])
  @@index([isActive])
  @@index([displayOrder])
  @@map("loan_types")
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
}

model LoanApplication {
  id String @id @default(uuid())

  userId String
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  loanTypeId String
  loanType   LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  applicationNumber String @unique
  loanAmount Decimal? @db.Decimal(15, 2)
  tenureMonths Int?
  interestRate Decimal? @db.Decimal(5, 2)
  processingFee Decimal? @db.Decimal(10, 2)
  emi Decimal? @db.Decimal(12, 2)
  totalInterest Decimal? @db.Decimal(15, 2)
  totalAmount Decimal? @db.Decimal(15, 2)
  configurationSnapshot Json?
  status LoanApplicationStatus @default(DRAFT)
  currentStep Int @default(1)
  submittedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?
  disbursedAt DateTime?
  statusHistory LoanApplicationStatusHistory[]
  emiSchedules EmiSchedule[]
  documents LoanDocument[]
  studentLoan StudentLoanApplication?
  personalLoan PersonalLoanApplication?
  schoolLoan SchoolStudentLoanApplication?
  existingLoans ExistingLoan[]

  infoAccuracyConsent Boolean @default(false)
  infoVerificationConsent Boolean @default(false)
  documentVerificationConsent Boolean @default(false)
  termsAccepted Boolean @default(false)
  privacyPolicyAccepted Boolean @default(false)
  consentedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([loanTypeId])
  @@index([status])

  @@map("loan_applications")
}

enum AdmissionStatus {
  APPLIED
  CONFIRMED
}

model StudentLoanApplication {
  id String @id @default(uuid())

  loanApplicationId String @unique
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  studentName String
  dateOfBirth DateTime
  gender Gender
  mobile String
  email String
  aadhaarNumber String?
  panNumber String?
  courseName String
  collegeName String
  universityName String
  studyCountry String
  courseDurationMonths Int
  admissionStatus AdmissionStatus
  estimatedCourseFee Decimal @db.Decimal(15, 2)
  parents ParentDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_loan_applications")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  OTHER
}

model ParentDetails {
  id String @id @default(uuid())

  studentLoanApplicationId String?
  studentLoanApplication StudentLoanApplication? @relation(fields: [studentLoanApplicationId], references: [id], onDelete: Cascade)

  schoolLoanApplicationId String?
  schoolLoanApplication SchoolStudentLoanApplication? @relation(fields: [schoolLoanApplicationId], references: [id], onDelete: Cascade)

  relation ParentRelation
  fullName String
  mobile String
  aadhaarNumber String?
  panNumber String?
  isCoApplicant Boolean @default(false)

  // Bank Details
  bankAccountNumber String?
  ifscCode String?

  gender Gender?
  dateOfBirth DateTime?
  maritalStatus MaritalStatus?
  numberOfDependents Int?
  numberOfEarningMembers Int?
  familyMonthlyIncome Decimal? @db.Decimal(12, 2)

  currentAddressId String?
  currentAddress Address? @relation("ParentCurrentAddress", fields: [currentAddressId], references: [id])
  permanentAddressId String?
  permanentAddress Address? @relation("ParentPermanentAddress", fields: [permanentAddressId], references: [id])
  sameAsCurrentAddress Boolean @default(false)
  yearsAtCurrentAddress Int?

  employment ParentEmployment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentLoanApplicationId, relation])
  @@unique([schoolLoanApplicationId, relation])
  @@index([studentLoanApplicationId])
  @@index([schoolLoanApplicationId])

  @@map("parent_details")
}
model ParentEmployment {
  id String @id @default(uuid())

  parentId String @unique
  parent ParentDetails @relation(fields: [parentId], references: [id], onDelete: Cascade )
  employmentType EmploymentType

  // Salaried
  companyName String?
  designation String?
  monthlyIncome Decimal? @db.Decimal(12, 2)
  experienceYears Int?
  industryType String?
  dateOfJoining DateTime?
  salaryFrequency String?
  previousYearIncome Decimal? @db.Decimal(12, 2)
  salaryAccountBank String?
  employerAddressId String?
  employerAddress Address? @relation("EmployerAddress", fields: [employerAddressId], references: [id])

  // Business
  businessName String?
  businessType String?
  annualTurnover Decimal? @db.Decimal(15, 2)
  annualIncome Decimal? @db.Decimal(12, 2)
  businessCategory String?
  businessStartDate DateTime?
  numberOfEmployees Int?
  numberOfBranches Int?
  yearsAtBusinessLocation Int?
  currentYearEstimatedIncome Decimal? @db.Decimal(12, 2)
  businessAddressId String?
  businessAddress Address? @relation("BusinessAddress", fields: [businessAddressId], references: [id])
  registrations BusinessRegistration[]

  // Farmer
  landHoldingAcres Decimal? @db.Decimal(10, 2)
  cropType String?
  agriculturalIncome Decimal? @db.Decimal(12, 2)
  landArea Decimal? @db.Decimal(10, 2)
  landUnit String?
  landOwnership LandOwnership?
  cultivatedArea Decimal? @db.Decimal(10, 2)
  otherCropTypes String?
  irrigationType String?
  landLocationVillage String?
  landAddressId String?
  landAddress Address? @relation("LandAddress", fields: [landAddressId], references: [id])

  // Contract
  employerName String?
  contractDurationMonths Int?

  // Other
  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent_employment")
}

enum LandOwnership {
  OWNED
  LEASED
  PARTIALLY_OWNED_LEASED
}

enum SchoolType {
  GOVERNMENT
  PRIVATE
  OTHER
}

enum SchoolClass {
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
}

model Institution {
  id String @id @default(uuid())

  name String
  schoolId String? @unique
  schoolType SchoolType
  city String
  taluka String?
  district String?
  state String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolLoanApplications SchoolStudentLoanApplication[]

  @@index([name])
  @@index([city])
  @@map("institutions")
}

model SchoolStudentLoanApplication {
  id String @id @default(uuid())

  loanApplicationId String @unique
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  studentName String
  dateOfBirth DateTime
  gender Gender
  mobile String?
  email String?
  aadhaarNumber String?
  panNumber String?

  currentSchoolName String
  institutionId String?
  institution Institution? @relation(fields: [institutionId], references: [id])
  schoolType SchoolType?
  currentClass SchoolClass
  academicYear String
  continuingSameSchool Boolean @default(true)

  previousSchoolName String?
  newSchoolName String?
  newInstitutionId String?
  expectedJoiningDate DateTime?

  previousClass SchoolClass?
  previousAcademicYear String?
  previousClassPercentage Decimal? @db.Decimal(5, 2)

  loanPurpose String?
  expectedDisbursementDate DateTime?
  tuitionFees Decimal? @db.Decimal(12, 2)
  admissionFees Decimal? @db.Decimal(12, 2)
  examinationFees Decimal? @db.Decimal(12, 2)
  booksAmount Decimal? @db.Decimal(12, 2)
  uniformAmount Decimal? @db.Decimal(12, 2)
  equipmentAmount Decimal? @db.Decimal(12, 2)
  transportAmount Decimal? @db.Decimal(12, 2)
  hostelAmount Decimal? @db.Decimal(12, 2)
  otherExpensesAmount Decimal? @db.Decimal(12, 2)
  familyContribution Decimal? @db.Decimal(12, 2)
  scholarshipAmount Decimal? @db.Decimal(12, 2)
  otherFundingAmount Decimal? @db.Decimal(12, 2)

  hasExistingLoans Boolean @default(false)

  coApplicants ParentDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@map("school_student_loan_applications")
}

enum BusinessRegistrationType {
  GST
  UDYAM
  SHOP_ESTABLISHMENT
  TRADE_LICENSE
  OTHER
}

model BusinessRegistration {
  id String @id @default(uuid())

  parentEmploymentId String
  parentEmployment ParentEmployment @relation(fields: [parentEmploymentId], references: [id], onDelete: Cascade)

  registrationType BusinessRegistrationType
  registrationNumber String
  issueDate DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentEmploymentId])
  @@map("business_registrations")
}

enum ExistingLoanStatus {
  ACTIVE
  CLOSED
  DELINQUENT
}

model ExistingLoan {
  id String @id @default(uuid())

  loanApplicationId String
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)

  loanTypeLabel String
  lenderName String
  loanAccountNumber String?
  originalAmount Decimal @db.Decimal(15, 2)
  outstandingAmount Decimal @db.Decimal(15, 2)
  emiAmount Decimal @db.Decimal(12, 2)
  interestRate Decimal? @db.Decimal(5, 2)
  startDate DateTime?
  originalTenureMonths Int?
  remainingTenureMonths Int?
  missedPaymentsCount Int? @default(0)
  lastEmiPaymentDate DateTime?
  status ExistingLoanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanApplicationId])
  @@map("existing_loans")
}

enum PersonalLoanPurpose {
  MEDICAL
  MARRIAGE
  TRAVEL
  HOME_RENOVATION
  BUSINESS
  EDUCATION
  DEBT_CONSOLIDATION
  OTHER
}

model PersonalLoanApplication {
  id String @id @default(uuid())

  loanApplicationId String @unique
  loanApplication LoanApplication @relation (fields: [loanApplicationId], references: [id],onDelete: Cascade)
  purpose PersonalLoanPurpose
  purposeDescription String?
  employment ApplicantEmployment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_loan_applications")
}

model ApplicantEmployment {
  id String @id @default(uuid())

  personalLoanApplicationId String @unique
  personalLoanApplication PersonalLoanApplication @relation( fields: [personalLoanApplicationId],references: [id],onDelete: Cascade)
  employmentType EmploymentType

  // Salaried
  companyName String?
  designation String?
  monthlyIncome Decimal? @db.Decimal(12, 2)
  experienceYears Int?

  // Self-employed
  profession String?

  // Business
  businessName String?
  businessType String?
  annualTurnover Decimal? @db.Decimal(15, 2)
  annualIncome Decimal? @db.Decimal(12, 2)

  // Contract
  employerName String?
  contractDurationMonths Int?

  // Other
  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applicant_employment")
}

enum ProcessingFeeType {
  FIXED
  PERCENTAGE
}

enum EMIStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

model LoanInterestConfiguration {
  id String @id @default(uuid())

  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)
  minAmount Decimal @db.Decimal(15, 2)
  maxAmount Decimal @db.Decimal(15, 2)
  minTenure Int
  maxTenure Int
  interestRate Decimal @db.Decimal(5, 2)
  processingFee Decimal @db.Decimal(10, 2)
  processingFeeType ProcessingFeeType
  gstPercentage Decimal @db.Decimal(5, 2)
  latePenalty Decimal? @db.Decimal(10, 2)
  foreclosureCharge Decimal? @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_interest_configurations")
}

model LoanEligibility {
  id String @id @default(uuid())
  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade)
  minimumAge Int
  maximumAge Int
  minimumIncome Decimal @db.Decimal(12, 2)
  minimumExperience Int?
  minimumCreditScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanTypeId])
  @@map("loan_eligibilities")
}

model LoanRequiredDocument {
  id String @id @default(uuid())

  loanTypeId String
  loanType LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Cascade )

  documentType DocumentType
  ownerType DocumentOwnerType
  employmentType EmploymentType?
  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([loanTypeId])
  @@index([documentType])

  @@map("loan_required_documents")
}
model LoanApplicationStatusHistory {
  id String @id @default(uuid())
  loanApplicationId String
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  status LoanApplicationStatus
  remarks String?
  changedById String
  changedBy User     @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([loanApplicationId])
  @@index([changedById])
  @@map("loan_application_status_history")
}

model EmiSchedule {
  id String @id @default(uuid())
  loanApplicationId String
  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate DateTime
  openingPrincipal Decimal @db.Decimal(15, 2)
  principalAmount Decimal @db.Decimal(15, 2)
  interestAmount Decimal @db.Decimal(15, 2)
  emiAmount Decimal @db.Decimal(15, 2)
  closingPrincipal Decimal @db.Decimal(15, 2)
  paidAmount Decimal @default(0) @db.Decimal(15, 2)
  paymentDate DateTime?
  latePenalty Decimal? @db.Decimal(10, 2)
  status EMIStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments EmiPayment[]

  @@index([loanApplicationId])
  @@index([status])
  @@index([dueDate])

  @@map("emi_schedules")
}

model EmiPayment {
  id String @id @default(uuid())
  emiScheduleId String
  emiSchedule EmiSchedule @relation(fields: [emiScheduleId], references: [id], onDelete: Cascade)
  paymentReference String @unique
  amount Decimal @db.Decimal(15, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus
  transactionId String?
  remarks String?
  paidAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([emiScheduleId])
  @@index([paymentStatus])

  @@map("emi_payments")
}